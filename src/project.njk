---
pagination:
  data: collections.projects
  size: 1
  alias: project
permalink: "proyectos/{{ project.fileSlug }}/index.html"
layout: base.njk
eleventyComputed:
  title: "{{ project.data.title }}"
  description: "{{ project.data.summary }}"
---
<section class="detail"><a class="back" href="/#projects">← Back to projects</a><div class="detail-hero"><div class="detail-cover"><img src="{{ project.data.cover or '/images/placeholder.svg' }}" alt="Cover image for {{ project.data.title }}"></div><div class="detail-intro"><div class="tags"><span class="chip">◇ {{ project.data.category | categoryEn }}</span><span class="chip">{{ project.data.version }}</span></div><h1>{{ project.data.title }}</h1><p>{{ project.data.summary }}</p><div class="actions">{% if project.data.curseforge %}<a class="btn primary" href="{{ project.data.curseforge }}" target="_blank" rel="noopener noreferrer">↓ &nbsp; DOWNLOAD NOW ↗</a>{% endif %}{% if project.data.trailer %}<a class="btn outline" href="{{ project.data.trailer }}" target="_blank" rel="noopener noreferrer">▶ &nbsp; {% if project.data.videoType == 'tutorial' %}Watch Tutorial{% elif project.data.videoType == 'video' %}Watch Video{% else %}Watch Trailer{% endif %}</a>{% endif %}</div></div></div><div class="meta-row"><div><span>Version</span><strong>{{ project.data.version }}</strong></div><div><span>Type</span><strong>{{ project.data.category | categoryEn }}</strong></div><div><span>Platform</span><strong>Minecraft Bedrock</strong></div></div><div class="section-divider"><span>✧</span></div><section class="detail-section"><p class="eyebrow">// INFORMATION</p><h2>Description</h2><div class="rich-text">{{ project.templateContent | safe }}</div></section>{% if project.data.features and project.data.features.length %}<section class="detail-section"><h2>Features</h2><ul class="features">{% for feature in project.data.features %}<li><span>✓</span> {{ feature }}</li>{% endfor %}</ul></section>{% endif %}{% if project.data.gallery and project.data.gallery.length %}
<section class="detail-section gallery-section" data-project-gallery>
  <div class="gallery-heading"><div><p class="eyebrow">// SCREENSHOTS</p><h2>Gallery</h2><p class="gallery-subtitle">Explore the addon features</p></div><span class="gallery-count">{{ project.data.gallery.length }} screenshots</span></div>
  <div class="gallery-viewer">
    <button type="button" class="gallery-stage" data-gallery-open aria-label="Expand screenshot"><img data-gallery-main src="{% set first = project.data.gallery[0] %}{% if first.image %}{{ first.image }}{% else %}{{ first }}{% endif %}" alt="Screenshot of {{ project.data.title }}"><span class="gallery-expand">⤢ Expand</span></button>
    <div class="gallery-caption"><div><h3 data-gallery-title>Screenshot 1</h3><p data-gallery-description hidden></p></div><span class="gallery-position" data-gallery-position>01 / {{ project.data.gallery.length }}</span></div>
    <div class="gallery-controls"><button type="button" data-gallery-prev aria-label="Previous screenshot">←</button><div class="gallery-thumbs" data-gallery-thumbs>
    {% for item in project.data.gallery %}{% set path = item.image or item %}<button type="button" class="gallery-thumb{% if loop.first %} active{% endif %}" data-gallery-index="{{ loop.index0 }}" aria-label="Show screenshot {{ loop.index }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}"><img src="{{ path }}" loading="lazy" alt="Screenshot {{ loop.index }}"></button>{% endfor %}
    </div><button type="button" data-gallery-next aria-label="Next screenshot">→</button></div>
  </div>
  <script type="application/json" data-gallery-data>{{ project.data.gallery | json | safe }}</script>
</section>
{% endif %}</section>